# Ry-Mark self-hosted configuration (Docker / Node server).
#
# Copy this file to .env and fill in the values. NEVER commit the filled copy.
#
# Generate PASSWORD_HASH with:  npm run hash:password
# Generate SESSION_SECRET with (example, macOS/Linux):
#   openssl rand -base64 48
# or on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Node.js (works everywhere):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"

# --- Authentication -----------------------------------------------------------
# "false" disables authentication and makes all content public.
# Missing/invalid values default to enabled (fail-closed).
AUTH_ENABLED=true

# REQUIRED when AUTH_ENABLED is not "false". Output of `npm run hash:password`.
PASSWORD_HASH=

# REQUIRED when AUTH_ENABLED is not "false". Long random value (min 32 chars).
SESSION_SECRET=

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# --- Server -------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Override the built frontend directory if needed (default: ./dist).
# DIST_DIR=/app/dist
